{
  "name": "n8n-nodes-sinergiacrm",
  "version": "2.2.2",
  "description": "A generic n8n node to operate with any SinergiaCRM (7.x+) module via the official JSON API.",
  "main": "dist/nodes/SinergiaCRM/SinergiaCRM.node.js",
  "types": "dist/nodes/SinergiaCRM/SinergiaCRM.node.d.ts",
  "scripts": {
    "build": "rimraf dist && tsc && cp nodes/SinergiaCRM/sinergiacrm.svg dist/nodes/SinergiaCRM/",
    "lint": "eslint . --resolve-plugins-relative-to .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "n8n",
    "sinergiacrm",
    "sinergiacrm",
    "n8n-node",
    "n8n-nodes",
    "n8n-custom-node",
    "n8n-community-node",
    "n8n-community-node-package"
  ],
  "author": "Javier Quílez <javier.quilez@gmail.com>",
  "organization": "Tecnología Solidaria",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tecnologia-Solidaria/n8n-nodes-sinergiacrm"
  },
  "bugs": {
    "url": "https://github.com/Tecnologia-Solidaria/n8n-nodes-sinergiacrm/issues"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "dist/nodes/SinergiaCRM/SinergiaCRM.node.js",
      "dist/nodes/SinergiaCRM/SinergiaCRMTrigger.node.js"
    ],
    "credentials": [
      "dist/credentials/SinergiaCRMCredentials.credentials.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.43.4",
    "@types/node": "^24.0.13",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "n8n-workflow": "1.82.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
